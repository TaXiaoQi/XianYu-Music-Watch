<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 系统闪屏强制接管：冷启动只认平台 windowSplashScreen*
         属性，LaunchTheme 的 windowBackground 启动图在该阶段不可见。
         白底（@color/splash_background，与窗口启动图同色）+ splash_icon
         （adaptive-icon：白底预缩放前景，详见该文件注释）——系统闪屏 →
         窗口启动图 → Flutter 全程白底品牌观感一致。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <!-- 同 values/styles.xml：必须保留，否则 API 31+ 设备上恢复系统
             「滑动关闭应用」兼容层，左滑会直接 finish 掉 Activity。 -->
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
</resources>
