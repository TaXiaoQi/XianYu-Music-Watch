<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 系统闪屏强制接管：冷启动只认平台 windowSplashScreen*
         属性，LaunchTheme 的 windowBackground 启动图在该阶段不可见。不配置
         时系统默认显示启动器 adaptive icon（白圆底 + 深色 logo），与窗口
         启动图的黑底白色 logo 两段式跳变。这里显式配置黑底 + 同源白色
         logo（drawable-*dpi/splash_logo），系统闪屏 → 窗口启动图 →
         Flutter 全程黑底白 logo，观感一致。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <!-- 同 values/styles.xml：必须保留，否则 API 31+ 设备上恢复系统
             「滑动关闭应用」兼容层，左滑会直接 finish 掉 Activity。 -->
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
</resources>
