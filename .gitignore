# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Release binaries — use GitHub Releases instead of committing APKs
/releases/

# ohos build state: pubspec_overrides.yaml is written by scripts/ohos/
# pub-state.ps1 during ohos builds ONLY and must never be committed (it would
# hijack Android pub get into ohos forks)
/pubspec_overrides.yaml

# 鸿蒙就地构建的 ohpm 物化产物（构建时自动生成）
**/oh_modules/
# 鸿蒙就地构建产物：rust .so 与 flutter_assets（每次构建重新生成）
/ohos/entry/libs/
/ohos/entry/src/main/resources/rawfile/
/ohos/.hvigor/

# Rust build artifacts
/rust/target/

# Signing credentials — never commit
/android/key.properties
/android/app/*.keystore
/android/app/*.jks

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# 软著申请材料不入库
软著申请材料/
